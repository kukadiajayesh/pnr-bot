# 10-digit PNR number(s) - single or comma-separated list
PNR=1234567890,9876543210

# Telegram Bot Token (from @BotFather)
TG_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID to receive alerts / authorized chat
CHAT_ID=your_chat_id_here

# RailRadar API Key for IRCTC PNR status (from api.railradar.in)
RAILRADAR_API_KEY=your_railradar_api_key_here

# Optional: Background check interval in minutes when running bot.py (default: 60)
CHECK_INTERVAL_MINUTES=60
