# Comma-separated list of 10-digit PNR numbers
PNR_LIST=1234567890,9876543210

# Telegram Bot Token (from @BotFather)
TG_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID to receive alerts
CHAT_ID=your_chat_id_here

# RailRadar API Key for IRCTC PNR status (from api.railradar.in)
RAILRADAR_API_KEY=your_railradar_api_key_here
